{
  "name": "gtfs-zone-feed-list",
  "version": "0.6.0",
  "description": "A list and a world map of every public GTFS feed, and whether it answers",
  "main": "src/index.html",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run knip",
    "lint": "eslint src/ vite.config.ts --max-warnings 0",
    "lint:fix": "eslint src/ vite.config.ts --fix",
    "format": "prettier --write src/ vite.config.ts",
    "knip": "knip",
    "vuln": "sh scripts/vuln-gate.sh",
    "commit": "cz commit"
  },
  "keywords": [
    "gtfs",
    "transit",
    "catalog",
    "map"
  ],
  "author": "gtfs.zone contributors",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@tailwindcss/postcss": "^4.3.3",
    "daisyui": "^5.7.46",
    "gtfs-zone-web-common": "github:gtfs-zone/gtfs-zone-web-common#v5.11.0",
    "maplibre-gl": "^6.11.2"
  }
}
